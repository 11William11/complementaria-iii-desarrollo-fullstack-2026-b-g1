{
  "info": {
    "name": "BarFlow · Products (semana 9, opcional)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "1. Listar productos (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Crear producto (201)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/products",
        "body": {
          "mode": "raw",
          "raw": "{ \"name\": \"Cerveza Swagger {{$timestamp}}\", \"category\": \"Cervezas\", \"price\": 4500, \"stockQuantity\": 60 }"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Id mal formado (400)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/products/no-es-un-uuid"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
